# Local development only. Run python scripts/setup-env.py for fresh secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=generate-with-setup-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=listen_capture
POSTGRES_USER=listen_capture
POSTGRES_PASSWORD=generate-with-setup-env
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POLLY_ENABLED=0
# Enable only after explicit owner approval of AWS charges and text disclosure.
POLLY_BILLING_APPROVED=0
# Native development only: requires DJANGO_DEBUG=1 and installed Japanese Haruka voice.
LC_LOCAL_WINDOWS_TTS=0
# Optional installed VOICEVOX engine, reached only from API/narration-worker.
# Native Windows: loopback; an isolated Docker engine may use http://voicevox:50021.
# This does not start/download an engine or enable any AWS/Polly calls.
VOICEVOX_ENABLED=0
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=14
# New narration only. Existing WAV/MP3 and immutable memo anchors are unchanged.
NARRATION_ENCODING=mp3
# Native helpers discover FFmpeg beside FFprobe; containers use installed tools.
AWS_REGION=ap-northeast-1
# Legacy requests: 3,000 code points; Narration requests: 20,000.
TTS_DAILY_USER_CHARACTERS=20000
TTS_DAILY_GLOBAL_CHARACTERS=100000
TTS_DAILY_USER_REQUESTS=20
TTS_USER_ACTIVE_JOBS=3
TTS_GLOBAL_ACTIVE_JOBS=100
# Test fixture flags are never enabled here; CI opts into an isolated fixture.
# DJANGO_DEBUG=0 enforces secure cookies and HTTPS redirect.
